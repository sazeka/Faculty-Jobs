      "title": "Assistant, Associate or Full Professor – AI Computing - Photonics — CUNY Advanced Science Research Center",
      "url": "https://cuny.jobs/new-york-ny/assistant-associate-or-full-professor-ai-computing-photonics-cuny-advanced-science-research-center/9A5A76FEFECA4E2DBFFD38E9103B6CBA/job/",
      "source": "NY",
