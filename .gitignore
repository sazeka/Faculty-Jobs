# Nightly automation run logs — local-only, regenerated each run, large.
# (daily-update.ps1 writes these; they were previously committed and bloated
# the repo ~760KB/night. The git add generated/ in the script skips ignored
# files, so this is all that's needed to stop tracking them.)
generated/automation-logs/

# Pure build intermediate: `npm run sync:web-data` regenerates this from
# public/jobs.json before every `vite build` (see package.json's
# build:frontend), so the committed copy was never actually read by anything —
# just a ~97MB duplicate of public/jobs.json re-added on every scrape commit.
web-vue/public/jobs.json

# The full dataset is public/jobs.json + public/job-descriptions/ (see
# scripts/lib/jobs-file.js). The site reads data/ chunks, so a published copy is
# only a ~90 MB file that pushes the repo toward GitHub's 100 MB limit.
docs/jobs.json
