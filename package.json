{
  "name": "faculty-jobs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faculty job scraper with static GitHub Pages frontend and automated daily updates",
  "scripts": {
    "test": "node --test \"scripts/__tests__/**/*.test.js\"",
    "start": "node server.js",
    "dev:frontend": "npm run sync:web-data && cd web-vue && npm run dev",
    "build:frontend": "npm run build:coverage && npm run sync:policy-exclusions && npm run sync:web-data && cd web-vue && npm run build && cd .. && node scripts/copy-dist.js && node scripts/generate-job-pages.js && node scripts/generate-hub-pages.js && node scripts/generate-rss.js && node scripts/generate-trends-pages.js && node scripts/generate-sitemap.js && node scripts/inject-og-meta.js",
    "generate:job-pages": "node scripts/generate-job-pages.js",
    "generate:hub-pages": "node scripts/generate-hub-pages.js",
    "generate:rss": "node scripts/generate-rss.js",
    "generate:trends-pages": "node scripts/generate-trends-pages.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "build:institutions": "node scripts/build-institutions-master.js",
    "reconcile:institutions": "node scripts/reconcile-national-institutions.js",
    "verify:career-links": "node scripts/verify-career-links.js",
    "verify:critical-schools": "node scripts/check-critical-schools.js",
    "verify:no-conflicts": "node scripts/check-merge-conflicts.js",
    "verify:post-quality": "node scripts/verify-post-quality.js",
    "clean:post-quality": "node scripts/apply-post-quality-cleanup.js",
    "upgrade:job-urls": "node scripts/upgrade-search-page-job-urls.js",
    "build:policy-exclusions": "node scripts/generate-policy-exclusions.js",
    "build:coverage-report": "node scripts/generate-coverage-report.js",
    "update:coverage-alert-thresholds": "node scripts/update-coverage-alert-thresholds.js",
    "audit:institutions": "node scripts/audit-institutions.js --fail-on-duplicates",
    "audit:institutions:strict": "node scripts/audit-institutions.js --strict",
    "verify:policy": "node scripts/verify-policy-integrity.js",
    "verify:policy:pre": "node scripts/verify-policy-integrity.js --skip-jobs-check",
    "sync:policy-exclusions": "node scripts/sync-policy-exclusions-web.js",
    "sync:web-data": "node scripts/sync-web-data-files.js",
    "import:ipeds": "node scripts/import-ipeds-csv.js",
    "seed:ipeds:webaddr": "node scripts/seed-missing-from-ipeds-webaddr.js --limit 25",
    "exclude:remaining-missing": "node scripts/exclude-unresolved-missing.js",
    "promote:seeded": "node scripts/promote-seeded-institutions.js --limit 2000",
    "promote:seeded:strict": "node scripts/promote-seeded-institutions.js --limit 2000 --seeded-only",
    "promote:apply": "node scripts/apply-promotion-candidates-to-server.js",
    "promote:next100": "node scripts/promote-next-batch.js --limit 100 --min-score 0",
    "promote:next100:apply": "npm run promote:next100 && node scripts/apply-promotion-candidates-to-server.js --input generated/promotion-candidates-next-batch.json --report generated/promotion-apply-next100-report.json",
    "promote:discovered": "node scripts/promote-next-batch.js --limit 1000 --min-score 0.3 --update-existing",
    "promote:discovered:apply": "npm run promote:discovered && node scripts/apply-promotion-candidates-to-server.js --input generated/promotion-candidates-next-batch.json --report generated/promotion-apply-discovered-report.json",
    "discover:careers": "node scripts/discover-career-pages.js",
    "discover:careers:apply": "node scripts/discover-career-pages.js --apply --limit 200",
    "discover:careers:batch": "node scripts/discover-careers-batch.js --batch-size 150 --max-batches 20 --rebuild-coverage",
    "probe:careers": "node scripts/probe-missing-career-paths.js --limit 200 --concurrency 10",
    "probe:careers:dry": "node scripts/probe-missing-career-paths.js --dry-run --limit 50 --concurrency 8",
    "build:coverage": "npm run build:institutions && npm run build:policy-exclusions && npm run sync:policy-exclusions && npm run build:coverage-report",
    "install:browsers": "playwright install chromium",
    "scrape:json": "node scripts/scrape-to-json.js",
    "release:dataset": "node scripts/release-dataset.js",
    "monitor:live": "node scripts/monitor-live-site.js",
    "verify:job-urls": "node scripts/verify-job-urls.js",
    "verify:job-urls:dry": "node scripts/verify-job-urls.js --dry-run",
    "agent:data-health": "node scripts/agent-data-health.js",
    "agent:data-health:dry": "node scripts/agent-data-health.js --dry-run",
    "generate:trends": "node scripts/generate-weekly-trends.js",
    "generate:trends:dry": "node scripts/generate-weekly-trends.js --dry-run",
    "agent:job-presence": "node scripts/agent-job-presence.js",
    "agent:job-presence:dry": "node scripts/agent-job-presence.js --dry-run",
    "agent:alert-issues": "node scripts/agent-alert-issues.js",
    "agent:alert-issues:dry": "node scripts/agent-alert-issues.js --dry-run",
    "send:job-alerts": "node scripts/send-job-alerts.js",
    "send:job-alerts:dry": "node scripts/send-job-alerts.js --dry-run",
    "agent:enrich": "node scripts/agent-job-enrichment.js",
    "agent:enrich:dry": "node scripts/agent-job-enrichment.js --dry-run",
    "agent:descriptions": "node scripts/agent-job-descriptions.js",
    "agent:descriptions:dry": "node scripts/agent-job-descriptions.js --dry-run",
    "agent:discover-careers": "node scripts/agent-career-discovery.js",
    "agent:discover-careers:dry": "node scripts/agent-career-discovery.js --dry-run --max 5",
    "inject:og-meta": "node scripts/inject-og-meta.js",
    "ollama": "ollama serve"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "node-fetch": "^2.7.0",
    "playwright": "^1.46.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
